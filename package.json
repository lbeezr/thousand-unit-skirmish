{
  "name": "thousand-unit-skirmish",
  "version": "0.95.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node room-supervisor.mjs",
    "test": "node scripts/ci.mjs",
    "test:fast": "node scripts/ci.mjs --lane=fast",
    "test:simulation": "node scripts/ci.mjs --lane=simulation",
    "test:visual": "node scripts/ci.mjs --lane=visual",
    "test:performance": "node scripts/ci.mjs --lane=performance",
    "architecture:check": "node scripts/check-runtime-imports.mjs",
    "check:types": "tsc --project tsconfig.check-js.json --pretty false && tsc --project tsconfig.check-node.json --pretty false",
    "build:painted-material-atlas": "python3 scripts/build-painted-material-atlas.py",
    "validate:visual-pack": "node scripts/validate-visual-pack.mjs",
    "validate:sprite-atlas": "node scripts/validate-sprite-atlas.mjs",
    "validate:painted-material-atlas": "node scripts/validate-painted-material-atlas.mjs",
    "validate:resource-atlas-pixels": "python3 scripts/inspect-resource-atlas-pixels.py",
    "validate:oak-fallback-atlas": "python3 scripts/prepare-oak-fallback-atlas.py",
    "validate:oak-depletion-atlas": "python3 scripts/build-oak-depletion-atlas.py",
    "preview:sprite-atlas": "node scripts/preview-sprite-atlas.mjs",
    "report:sprite-atlas-handoff": "node scripts/report-sprite-atlas-handoff.mjs",
    "release:pack": "node scripts/pack-railway-release.mjs",
    "release:smoke": "node scripts/railway-smoke.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "audit:asset-adoption": "node scripts/audit-asset-adoption.mjs",
    "validate:quiet-terrain": "python3 scripts/validate-quiet-terrain.py",
    "validate:environment-plants": "node scripts/validate-environment-plants.mjs",
    "validate:environment-plant-alpha": "python3 scripts/validate-environment-plant-alpha.py"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "acorn": "8.15.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3"
  }
}
